{
  "name": "pi-better-render",
  "version": "0.1.0",
  "description": "Streaming-first rich Markdown, code and math rendering for the pi TUI (display-only; never touches LLM context).",
  "keywords": [
    "pi-package",
    "pi",
    "markdown",
    "latex",
    "mathjax",
    "kitty",
    "ghostty"
  ],
  "author": "Jiefeng Zhou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffeyChou/pi-better-render.git"
  },
  "homepage": "https://github.com/JeffeyChou/pi-better-render#readme",
  "bugs": {
    "url": "https://github.com/JeffeyChou/pi-better-render/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://cdn.jsdelivr.net/gh/JeffeyChou/pi-better-render@main/assets/demo.mp4",
    "image": "https://cdn.jsdelivr.net/gh/JeffeyChou/pi-better-render@main/assets/demo.gif"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/bundle-mathjax.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bench": "node --import tsx test/bench.ts",
    "preview": "node --import tsx test/preview.ts",
    "pretest": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.86.1",
    "@mathjax/mathjax-bbm-font-extension": "^4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
    "@mathjax/mathjax-dsfont-font-extension": "^4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@types/node": "^24.0.0",
    "beautiful-mermaid": "^1.1.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
